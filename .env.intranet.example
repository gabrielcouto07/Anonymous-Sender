# ============================================================================
#  Canal de Ética & Compliance (OEA) — PERFIL INTRANET (HTTP direto na porta)
#
#  Use este modelo quando o acesso for http://srvapp01:8980 direto na porta,
#  SEM proxy reverso e SEM certificado.
#
#      Copy-Item .env.intranet.example .env
#
#  Se um dia o canal for publicado com HTTPS pelo IIS, troque para o outro
#  modelo (.env.example), que já vem com o perfil de proxy TLS.
#
#  Diferença entre os dois perfis, e o porquê:
#    .env.example           HOST=127.0.0.1 + REQUIRE_HTTPS=true
#                           A aplicação recusa qualquer acesso que não seja
#                           HTTPS. Só funciona atrás de um proxy TLS.
#    .env.intranet.example  HOST=0.0.0.0   + REQUIRE_HTTPS=false
#                           A aplicação atende a rede interna direto na porta.
# ============================================================================

# --- Servidor HTTP ----------------------------------------------------------
# 0.0.0.0 = aceita conexões de qualquer máquina da rede interna.
# É isso que permite abrir http://srvapp01:8980 de outro computador.
HOST=0.0.0.0

# Porta exclusiva deste canal. Confira antes que ninguém a esteja usando:
#   Get-NetTCPConnection -LocalPort 8980 -State Listen
PORT=8980

# Threads do Waitress. 4 é mais que suficiente para um canal de relatos.
THREADS=4

# Sem proxy TLS: o esquema público é o mesmo do socket (http).
URL_SCHEME=http

# false = permite HTTP. Com true, a aplicação responderia 400 em todas as
# páginas, porque ela foi feita para falhar fechada se o TLS estiver mal
# configurado. Em rede interna sem certificado, mantenha false.
REQUIRE_HTTPS=false

# Deixe VAZIO. Assim a checagem de origem usa o próprio endereço que o
# navegador acessou, e o canal funciona tanto por http://srvapp01:8980
# quanto por http://192.168.0.187:8980. Preencher aqui travaria um deles.
PUBLIC_ORIGIN=

# --- SMTP (conta remetente) -------------------------------------------------
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
# starttls (porta 587)  |  ssl (porta 465)  |  none (relay interno na porta 25)
SMTP_SECURITY=starttls
SMTP_USER=chamados@scientificdental.com
SMTP_PASSWORD=
# Segundos até desistir de uma conexão SMTP travada
SMTP_TIMEOUT=30

# --- Endereços --------------------------------------------------------------
MAIL_FROM=chamados@scientificdental.com
MAIL_TO=compliance@scientificdental.com
SUBJECT_PREFIX=[CANAL DE ÉTICA & COMPLIANCE - OEA] Novo Relato Registrado

# --- Comportamento ----------------------------------------------------------
TZ_NAME=America/Sao_Paulo
COMPANY_NAME=Scientific Dental
MAX_MESSAGE_CHARS=10000
MIN_MESSAGE_CHARS=20
MAX_NAME_CHARS=120

# Proteção anti-flood GLOBAL (não identifica ninguém): envios por janela.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=600

# true = descarta o e-mail sem enviar (teste sem SMTP). Produção: false.
DRY_RUN=false
