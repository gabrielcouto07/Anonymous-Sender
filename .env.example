# ============================================================================
#  Canal de Ética & Compliance (OEA) — configuração
#  Copie este arquivo para ".env" (mesma pasta do app.py) e ajuste os valores.
#  Variáveis de ambiente do sistema têm prioridade sobre este arquivo.
# ============================================================================

# --- Servidor HTTP ----------------------------------------------------------
# Produção: escute apenas no loopback. IIS/ARR termina o HTTPS e encaminha
# internamente para 127.0.0.1:8980; a porta 8980 não deve ficar exposta na rede.
HOST=127.0.0.1
PORT=8980
# Threads do Waitress. 4 é mais que suficiente para um canal de relatos.
THREADS=4
# O socket interno do Waitress continua HTTP, mas todas as URLs públicas são HTTPS.
URL_SCHEME=https
REQUIRE_HTTPS=true
# Origem pública exata, sem barra final. Ajuste se usar outro nome DNS.
PUBLIC_ORIGIN=https://srvapp01

# --- SMTP (conta remetente) -------------------------------------------------
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
# starttls (porta 587)  |  ssl (porta 465)  |  none (relay interno na porta 25, sem TLS)
SMTP_SECURITY=starttls
SMTP_USER=chamados@scientificdental.com
SMTP_PASSWORD=
# Segundos até desistir de uma conexão SMTP travada
SMTP_TIMEOUT=30

# --- Endereços --------------------------------------------------------------
# Remetente exibido no e-mail (normalmente igual ao SMTP_USER)
MAIL_FROM=chamados@scientificdental.com
# Destinatário dos relatos. Para mais de um, separe por vírgula.
MAIL_TO=compliance@scientificdental.com
SUBJECT_PREFIX=[CANAL DE ÉTICA & COMPLIANCE - OEA] Novo Relato Registrado

# --- Comportamento ----------------------------------------------------------
TZ_NAME=America/Sao_Paulo
COMPANY_NAME=Scientific Dental
MAX_MESSAGE_CHARS=10000
MIN_MESSAGE_CHARS=20
MAX_NAME_CHARS=120

# Proteção anti-flood GLOBAL (não identifica ninguém): máximo de envios por janela.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=600

# true = descarta o e-mail sem enviar e sem gravar seu conteúdo (teste sem SMTP)
DRY_RUN=false
