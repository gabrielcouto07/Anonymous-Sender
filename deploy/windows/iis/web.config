<?xml version="1.0" encoding="UTF-8"?>
<!--
  Site IIS de terminação HTTPS para o Canal de Compliance.
  Pré-requisitos: IIS, URL Rewrite e ARR com proxy habilitado no nível do servidor.
  Aponte a raiz física do site para esta pasta e mantenha somente um binding HTTPS.
-->
<configuration>
  <system.webServer>
    <!-- Impede que o IIS crie access logs com IP/URL para este site. -->
    <httpLogging dontLog="true" selectiveLogging="LogSuccessful" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <rewrite>
      <rules>
        <rule name="CanalComplianceReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8980/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
